# ==============================================================================
# Software Factory Configuration
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# Values in this file should NOT be wrapped in quotes.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Vercel Sandbox Credentials (Required)
# ------------------------------------------------------------------------------
# Option A: Access Token Authentication (Required for Docker, Compose, and CI/CD)
# Generate a Personal Access Token at: https://vercel.com/account/tokens
# Find Team ID & Project ID in your Vercel Project Settings or .vercel/project.json
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Option B: Vercel OIDC Token (Alternative for local development via `vercel env pull`)
# If VERCEL_TOKEN, VERCEL_TEAM_ID, and VERCEL_PROJECT_ID are provided, they take precedence.
# VERCEL_OIDC_TOKEN=

# ------------------------------------------------------------------------------
# 2. Google Gemini AI Configuration (Required)
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
# Gemini model ID (e.g. gemini-3.5-flash, gemini-3.5-flash-lite, gemini-3.5-pro)
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 3. Target Repository Configuration
# ------------------------------------------------------------------------------
# Default repository to clone in the ephemeral sandbox (can be overridden via CLI --repo)
REPO_URL=https://github.com/vrajrupareliya/turbo-start-sanity
# Default branch, commit, or tag (can be overridden via CLI --ref)
REPO_REF=main
# Optional: GitHub personal access token for private repositories
# GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 4. Agent & Orchestrator Gate Settings
# ------------------------------------------------------------------------------
# Maximum steps the agent can take per round (default: 25)
MAX_AGENT_STEPS=25
# Maximum automated repair rounds after baseline gate failure (default: 3)
MAX_REPAIR_ROUNDS=3
# Lock sandbox network policy to deny-all after dependency installation (default: false)
DENY_NETWORK_AFTER_INSTALL=false

# ------------------------------------------------------------------------------
# 5. Benchmark Suite Settings
# ------------------------------------------------------------------------------
# Delay in seconds between benchmark tickets to avoid API rate limits (default: 20)
BENCH_DELAY_SECONDS=20

# ------------------------------------------------------------------------------
# 6. GitHub Pull Request Automation (Required only when running with --pr)
# ------------------------------------------------------------------------------
# Fine-grained GitHub personal access token with Contents (read & write)
# and Pull requests (read & write) permissions scoped strictly to the target fork.
GITHUB_PR_TOKEN=

# ------------------------------------------------------------------------------
# 7. Placeholder Environment Variables (Passed to sandbox execution)
# ------------------------------------------------------------------------------
SANITY_STUDIO_PROJECT_ID=placeholder-project-id
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder-project-id
NEXT_PUBLIC_SANITY_DATASET=production
