VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
REPO_URL=https://github.com/vrajrupareliya/turbo-start-sanity
REPO_REF=main
# Optional: GitHub personal access token for private repositories
# GITHUB_TOKEN=
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
MAX_AGENT_STEPS=25
MAX_REPAIR_ROUNDS=3
DENY_NETWORK_AFTER_INSTALL=false
SANITY_STUDIO_PROJECT_ID=placeholder-project-id
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=placeholder-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Required only with --pr: fine-grained GitHub personal access token with
# Contents (read & write) and Pull requests (read & write) permissions on the fork only.
GITHUB_PR_TOKEN=
