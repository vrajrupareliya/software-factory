{
  "name": "software-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "bench": "tsx src/bench.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "node --import tsx --test test/bench.test.ts",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:run": "docker compose run --rm factory",
    "docker:bench": "docker compose run --rm bench"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.120",
    "@octokit/rest": "^22.0.1",
    "@vercel/sandbox": "latest",
    "ai": "^7.0.172",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "latest",
    "typescript": "latest"
  }
}
